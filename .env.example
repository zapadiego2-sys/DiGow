# Ruta donde se publica la app, con barra inicial y final. En GitHub Pages: /nombre-repo/
VITE_BASE_PATH=/

# URL de un logo externo. Si no carga, se usa public/brand/logo.png y luego el texto "Cotizador".
VITE_BRAND_LOGO_URL=

# "true" hace fallar todas las operaciones de los repositorios mock, para probar estados de error.
VITE_MOCK_FORCE_ERRORS=false
